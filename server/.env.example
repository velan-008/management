# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=businessflow_dev
