DB_PASSWORD=your_secure_password

# Test Database Configuration
DB_TEST_NAME=businessflow_test

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=8h
