{
  "name": "businessflow-server",
  "version": "1.0.0",
  "description": "BUSINESSFLOW — Backend REST API & Services",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:migrate:undo": "node src/database/migrate.js undo",
    "db:seed": "node src/database/seed.js",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
